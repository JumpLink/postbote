{
  "name": "postbote-cli",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "description": "Postbote app: the `postbote` binary \u2014 CLI + MCP frontends over the @postbote/* packages, bundled to a single .gjs.mjs and run on GJS via gjsify.",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check": "gjsify tsc --noEmit",
    "format": "gjsify format --write .",
    "format:check": "gjsify format --check .",
    "lint": "gjsify lint .",
    "lint:fix": "gjsify lint --fix .",
    "build": "gjsify run build:gjs",
    "build:gjs": "gjsify build src/index.ts --app gjs --outfile dist/postbote.gjs.mjs",
    "start": "gjsify run dist/postbote.gjs.mjs",
    "dev": "gjsify run build:gjs && gjsify run start",
    "test": "gjsify test",
    "test:mcp": "node tests/integration/mcp-gjs-smoke.mjs"
  },
  "gjsify": {
    "excludeGlobals": [
      "document",
      "navigator",
      "HTMLElement",
      "location",
      "Image",
      "HTMLCanvasElement",
      "HTMLImageElement",
      "FontFace",
      "matchMedia",
      "MutationObserver",
      "ResizeObserver",
      "IntersectionObserver"
    ],
    "test": {
      "entry": "tests/test.mts",
      "outdir": "dist",
      "runtimes": [
        "gjs",
        "node"
      ]
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@postbote/gnome": "*",
    "@postbote/imap": "*",
    "@postbote/protocol": "*",
    "@postbote/store": "*",
    "dotenv": "^17.4.2",
    "yargs": "^18.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@gjsify/cli": "0.49.0",
    "@gjsify/node-globals": "0.49.0",
    "@gjsify/rolldown-native": "0.49.0",
    "@gjsify/runtime": "0.49.0",
    "@gjsify/unit": "0.49.0",
    "@types/node": "^26.1.2",
    "@types/yargs": "^17.0.35",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "typescript": "^6.0.3"
  }
}
