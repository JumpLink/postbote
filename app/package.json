{
  "name": "postbote-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Postbote app: the `postbote` binary — CLI + MCP frontends over the @postbote/* packages, bundled to a single .gjs.mjs and run on GJS via gjsify.",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check": "gjsify tsc --noEmit",
    "format": "gjsify format --write .",
    "format:check": "gjsify format --check .",
    "lint": "gjsify lint .",
    "lint:fix": "gjsify lint --fix .",
    "build": "gjsify run build:gjs",
    "build:gjs": "gjsify build src/index.ts --app gjs --outfile dist/postbote.gjs.mjs",
    "start": "gjsify run dist/postbote.gjs.mjs",
    "dev": "gjsify run build:gjs && gjsify run start",
    "test": "gjsify test"
  },
  "gjsify": {
    "_comment_minify": "fixed upstream in gjsify: the minifier re-encodes the '\\u0000' escape in @postbote/protocol's IMAP literal placeholder as a RAW NUL byte, and GJS then fails to parse the bundle ('literal not terminated before end of script'). Remove this once that is fixed upstream — it is not a size preference. Verify with: tr -dc '\\000' < app/dist/postbote.gjs.mjs | wc -c",
    "bundler": {
      "output": {
        "minify": false
      }
    },
    "excludeGlobals": [
      "document",
      "navigator",
      "HTMLElement",
      "location",
      "Image",
      "HTMLCanvasElement",
      "HTMLImageElement",
      "FontFace",
      "matchMedia",
      "MutationObserver",
      "ResizeObserver",
      "IntersectionObserver"
    ],
    "test": {
      "entry": "tests/test.mts",
      "outdir": "dist",
      "runtimes": ["gjs", "node"]
    }
  },
  "dependencies": {
    "@postbote/gnome": "*",
    "@postbote/imap": "*",
    "@postbote/protocol": "*",
    "dotenv": "^17.4.2",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@gjsify/cli": "0.30.0",
    "@gjsify/node-globals": "0.30.0",
    "@gjsify/runtime": "0.30.0",
    "@gjsify/unit": "0.30.0",
    "@types/node": "^26.1.2",
    "@types/yargs": "^17.0.35",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "typescript": "^6.0.3"
  }
}
