{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "@girs/gjs",
      "@girs/glib-2.0",
      "@girs/gobject-2.0",
      "@girs/gio-2.0",
      "@girs/goa-1.0"
    ]
  },
  "include": ["./src/**/*"]
}
